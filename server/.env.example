# ==========================================
# My-YouTube Backend Environment Variables Example
# Copy this file to .env and fill in your values
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
DB_URL=mongodb+srv://your_username:your_password@cluster0.mongodb.net/myyoutube?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
DOWNLOAD_TOKEN_SECRET=your_download_token_secret_here

# Nodemailer SMTP Email Service (For Security OTPs & Transaction Invoices)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
SENDER_EMAIL=subscriptions@myyoutube.com

# Brevo API Key (Optional Alternative Email Provider)
BREVO_API_KEY=your_brevo_api_key_here

# Razorpay Test Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Cloudinary Storage Configuration (Optional Video Upload Backup)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Application URL
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
