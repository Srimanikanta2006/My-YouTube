# Backend REST & WebSocket Base URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Razorpay Test Key ID (Public key for checkout popup)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
